<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android application ID: com.bitaqati.app (set by Gradle). It must match
         the Android OAuth client registered for Google Sign-In. -->
    <!-- Supabase Auth and Google sign-in need network access in release builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Daily study reminders. POST_NOTIFICATIONS is required from Android 13;
         SCHEDULE_EXACT_ALARM lets a reminder land at the minute it promises
         instead of "sometime this hour", and is gracefully downgraded to an
         inexact alarm when the user refuses it. RECEIVE_BOOT_COMPLETED is what
         lets the plugin re-arm every pending reminder after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Recording a voice note for a card. Requested at the moment the learner
         taps record, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="بطاقاتي"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- No MAIN/LAUNCHER filter here on purpose. Every launcher icon,
                 including the default one, is an activity-alias below, because
                 switching icons works by disabling every alias except the
                 chosen one. If MainActivity itself carried the launcher filter
                 it would have to be disabled too, and disabling the alias
                 target makes all of the aliases unlaunchable. -->
            <!-- Legacy custom scheme, kept so links shared by older builds
                 still open the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="bitaqati" android:host="deck"/>
            </intent-filter>
            <!-- Android App Link: https://bitaqati.app/deck/<id> opens the app
                 when it is installed, and the web preview otherwise.
                 Verification needs https://bitaqati.app/.well-known/assetlinks.json
                 to list this package with the release signing SHA-256. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="bitaqati.app"
                    android:pathPrefix="/deck/"/>
            </intent-filter>
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        <!-- The three launcher icons. Exactly one alias is enabled at a time;
             the plugin flips them and Android swaps the icon on the home screen
             without a reinstall. `.DEFAULT` is the yellow card and is the only
             one enabled in a fresh install, so a device that never opens the
             picker keeps the icon the release was built around. -->
        <activity-alias
            android:name=".DEFAULT"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".CrownIcon"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/launcher_icon_crown"
            android:roundIcon="@mipmap/launcher_icon_crown">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".BlueIcon"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/launcher_icon_blue"
            android:roundIcon="@mipmap/launcher_icon_blue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Holds the icon the user picked until the task is removed, then
             applies it. The swap has to happen after the app has left the
             screen: a launcher resolves a package icon while it is in front, so
             flipping the alias earlier leaves the home screen showing the old
             artwork. stopWithTask must stay false or onTaskRemoved is never
             delivered, and the service must be declared here because the
             plugin's own manifest does not declare it. -->
        <service
            android:name="com.solusibejo.flutter_dynamic_icon_plus.FlutterDynamicIconPlusService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"/>
        <!-- uCrop, the native cropper behind image_cropper. It has to be
             declared by the host app or cropping crashes the moment it opens.
             The AppCompat theme is what uCrop's own activity expects. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- Delivers a reminder whose moment has arrived. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <!-- Re-arms every pending reminder after a reboot or an app update.
             Without this, a phone restarted overnight would silently lose the
             whole day's reminders. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
